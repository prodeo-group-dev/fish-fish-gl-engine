// CloudFront Function template - the ${expected_auth} placeholder is
// filled in by Terraform's templatefile() (see pitch_basic_auth.tf),
// sourced from Secrets Manager at apply time. No credential is ever
// written to this file on disk or committed to git.

function handler(event) {
    var request = event.request;
    var headers = request.headers;
    var expected = 'Basic ${expected_auth}';

    if (typeof headers.authorization === 'undefined' || headers.authorization.value !== expected) {
        return {
            statusCode: 401,
            statusDescription: 'Unauthorized',
            headers: {
                'www-authenticate': { value: 'Basic realm="Prodeo Capital - Confidential"' }
            }
        };
    }

    return request;
}
