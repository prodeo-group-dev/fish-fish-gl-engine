.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
*.iml
.idea/
out/

# Claude Code runtime state - process-local, never committed (caught
# 2026-08-26 after landing in a commit via git add -A)
.claude/scheduled_tasks.lock

# Local database credentials (docs/DDD_Design.md Section 10) - never committed
.env
.env.local

# Terraform (infra/terraform/) - local state holds real resource IDs
# and, per variables.tf's own caveat, db_password in plaintext (a
# known Terraform limitation until a remote encrypted backend is
# configured) - never committed. .terraform/ is just downloaded
# provider binaries, safe to regenerate via `terraform init`.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
infra/terraform/crash.log
infra/terraform/tfplan*
infra/terraform/*.tfplan
infra/terraform/override.tf
infra/terraform/override.tf.json

# Scratch operational artifacts (task-def JSON snapshots used for manual
# ECS register-task-definition patching, apply/wait logs) - one-off
# debugging output, not IaC, never worth committing. The live task defs
# and apply state are always re-fetchable from AWS/Terraform directly.
infra/terraform/*_taskdef*.json
infra/terraform/*.log
*.log
