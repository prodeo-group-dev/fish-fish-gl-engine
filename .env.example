# Local Postgres connection for the persistence layer (docs/DDD_Design.md
# Section 10). Copy this file to .env.local, fill in real values, and
# export the variables into your shell before running `gradle
# integrationTest` (or set them in your IDE's run configuration).
# .env/.env.local are gitignored - never commit real credentials.
#
# See docs/DDD_Design.md Section 10 for how to create the fish_dev role
# and database this defaults to.

FISH_DB_HOST=localhost
FISH_DB_PORT=5432
FISH_DB_NAME=fish_dev
FISH_DB_USER=fish_dev
FISH_DB_PASSWORD=

# Web/API layer (docs/DDD_Design.md Section 10.19) - required to run
# `gradle run` / the packaged jar / the Docker image. Not needed for
# `gradle test`/`gradle integrationTest`, which don't start the HTTP
# server. FISH_JWT_ISSUER/AUDIENCE/JWKS_URL point at whichever external
# identity provider issues tokens for this deployment (AWS Cognito,
# Auth0, etc.) - this app verifies tokens, it never issues its own.
FISH_HTTP_PORT=8080
FISH_JWT_ISSUER=
FISH_JWT_AUDIENCE=
FISH_JWT_JWKS_URL=
